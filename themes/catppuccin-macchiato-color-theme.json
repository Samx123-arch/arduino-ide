{
  "$schema": "vscode://schemas/color-theme",
  "name": "Catppuccin Macchiato",
  "type": "dark",
  "colors": {
    "focusBorder": "#b7bdf8",
    "foreground": "#cad3f5",
    "descriptionForeground": "#a5adcb",
    "disabledForeground": "#6e738d",
    "errorForeground": "#ed8796",
    "icon.foreground": "#b8c0e0",
    "editor.background": "#24273a",
    "editor.foreground": "#cad3f5",
    "editorLineNumber.foreground": "#6e738d",
    "editorLineNumber.activeForeground": "#b7bdf8",
    "editorCursor.foreground": "#f4dbd6",
    "editor.selectionBackground": "#494d64",
    "editor.inactiveSelectionBackground": "#363a4f",
    "editor.lineHighlightBackground": "#1e2030",
    "editorIndentGuide.background1": "#363a4f",
    "editorIndentGuide.activeBackground1": "#6e738d",
    "editorWhitespace.foreground": "#494d64",
    "editorWidget.background": "#1e2030",
    "editorWidget.border": "#494d64",
    "editorSuggestWidget.background": "#1e2030",
    "editorSuggestWidget.foreground": "#cad3f5",
    "editorSuggestWidget.selectedBackground": "#494d64",
    "editorHoverWidget.background": "#1e2030",
    "sideBar.background": "#1e2030",
    "sideBar.foreground": "#cad3f5",
    "sideBar.border": "#181926",
    "sideBarTitle.foreground": "#cad3f5",
    "sideBarSectionHeader.background": "#24273a",
    "activityBar.background": "#181926",
    "activityBar.foreground": "#b7bdf8",
    "activityBar.inactiveForeground": "#6e738d",
    "activityBar.border": "#181926",
    "panel.background": "#1e2030",
    "panel.border": "#363a4f",
    "panelTitle.activeForeground": "#b7bdf8",
    "panelTitle.inactiveForeground": "#a5adcb",
    "statusBar.background": "#1e2030",
    "statusBar.foreground": "#cad3f5",
    "statusBar.border": "#1e2030",
    "statusBar.debuggingBackground": "#ed8796",
    "statusBar.debuggingForeground": "#24273a",
    "titleBar.activeBackground": "#1e2030",
    "titleBar.activeForeground": "#cad3f5",
    "titleBar.inactiveBackground": "#1e2030",
    "titleBar.inactiveForeground": "#a5adcb",
    "tab.activeBackground": "#24273a",
    "tab.activeForeground": "#b7bdf8",
    "tab.inactiveBackground": "#1e2030",
    "tab.inactiveForeground": "#a5adcb",
    "tab.border": "#181926",
    "tab.activeBorderTop": "#b7bdf8",
    "button.background": "#b7bdf8",
    "button.foreground": "#24273a",
    "button.hoverBackground": "#8aadf4",
    "input.background": "#1e2030",
    "input.foreground": "#cad3f5",
    "input.border": "#494d64",
    "input.placeholderForeground": "#6e738d",
    "dropdown.background": "#1e2030",
    "dropdown.foreground": "#cad3f5",
    "dropdown.border": "#494d64",
    "list.activeSelectionBackground": "#494d64",
    "list.activeSelectionForeground": "#cad3f5",
    "list.hoverBackground": "#363a4f",
    "list.inactiveSelectionBackground": "#363a4f",
    "terminal.background": "#24273a",
    "terminal.foreground": "#cad3f5",
    "terminal.ansiBlack": "#494d64",
    "terminal.ansiRed": "#ed8796",
    "terminal.ansiGreen": "#a6da95",
    "terminal.ansiYellow": "#eed49f",
    "terminal.ansiBlue": "#8aadf4",
    "terminal.ansiMagenta": "#f5bde6",
    "terminal.ansiCyan": "#8bd5ca",
    "terminal.ansiWhite": "#b8c0e0",
    "terminal.ansiBrightBlack": "#5b6078",
    "terminal.ansiBrightRed": "#ed8796",
    "terminal.ansiBrightGreen": "#a6da95",
    "terminal.ansiBrightYellow": "#eed49f",
    "terminal.ansiBrightBlue": "#8aadf4",
    "terminal.ansiBrightMagenta": "#f5bde6",
    "terminal.ansiBrightCyan": "#8bd5ca",
    "terminal.ansiBrightWhite": "#a5adcb"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8087a2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#c6a0f6"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#a6da95"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#f5a97f"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8aadf4"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#eed49f"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#cad3f5"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#91d7e3"
      }
    },
    {
      "name": "Preprocessor directives",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#ed8796"
      }
    },
    {
      "name": "Constants and macros",
      "scope": [
        "variable.other.constant",
        "entity.name.constant",
        "constant"
      ],
      "settings": {
        "foreground": "#f5a97f"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#ee99a0"
      }
    }
  ]
}
